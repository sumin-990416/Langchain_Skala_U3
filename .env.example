# Live analysis requires an OpenAI API key. Demo mode does not.
OPENAI_API_KEY=

# Optional LangSmith tracing. Set true and provide your own API key to enable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Langchain_Skala_U3

# Existing LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY / LANGCHAIN_PROJECT
# names are also accepted for compatibility. Do not commit real keys.
